# Все текстовые файлы — LF в рабочей копии при любом core.autocrlf (Windows): с CRLF тесты,
# читающие исходники регулярками, и сверки манифестов расходятся. Правила ниже уточняют это.
* text=auto eol=lf

# Что НЕ попадает в Composer-пакет (git archive соблюдает export-ignore).
#
# Список обязан совпадать со списком KEEP в build.sh, иначе на портал уедет
# разное в зависимости от способа установки: zip из build.sh и пакет Composer
# соберутся по разным правилам. Сверяется автоматически, см. build.sh,
# check_gitattributes.

/.claude/		export-ignore
/.gitattributes		export-ignore
/.github/		export-ignore
/.gitignore		export-ignore
/.php-cs-fixer.dist.php	export-ignore
/CLAUDE.md		export-ignore
/CONTRIBUTING.md	export-ignore
/docs/			export-ignore
/examples/		export-ignore
/build.sh		export-ignore
/composer.lock		export-ignore
/tests/			export-ignore

*.png		binary
*.jpg		binary
*.webp		binary
*.woff2		binary
*.ico		binary
*.gz		binary
*.zip		binary
